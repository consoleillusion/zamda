{
  "name": "@zamda/bgp-globe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live Internet: the global BGP routing table on a globe, computed by zamda on JS or WASM.",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "dev": "bun scripts/setup.ts && astro dev",
    "build": "bun scripts/setup.ts && astro build",
    "preview": "astro preview",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "bun test --conditions=zamda-source",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@astrojs/svelte": "9",
    "@deck.gl/core": "9",
    "@deck.gl/layers": "9",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@zamda/bgp-data": "workspace:*",
    "astro": "7",
    "svelte": "5",
    "zamda": "workspace:*"
  },
  "devDependencies": {
    "svelte-check": "^4.7.8",
    "typescript": "5.9.3"
  }
}
