{
  "name": "zamda-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "bench",
    "apps/*"
  ],
  "scripts": {
    "check": "bun run --cwd packages/zamda check && bun run --cwd packages/bgp-data check && bun run --cwd bench check && bun run --cwd apps/bgp-globe check",
    "lint": "eslint .",
    "test": "bun run --cwd packages/zamda test && bun run --cwd packages/bgp-data test && bun run --cwd bench test",
    "build": "bun run --cwd packages/zamda build:all",
    "prep-bgp": "bun run --cwd packages/bgp-data prep",
    "fake-routes": "bun run --cwd packages/bgp-data fake",
    "demo": "bun run --cwd apps/bgp-globe dev",
    "bench": "bun run --cwd bench ref",
    "prep-globe": "bun run --cwd packages/bgp-data prep:globe"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/utils": "^8.73.0",
    "eslint": "^10.15.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0"
  }
}
